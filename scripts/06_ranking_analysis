/*
===============================================================================
Ranking Analysis: Identifying Top and Bottom Performers
===============================================================================
Goal:
    Order products and customers by revenue or order activity to surface
    the best and weakest performers. Both the quick TOP N approach and the
    more flexible window-function approach are shown.

SQL features used:
    - Ranking window functions: RANK()
    - TOP (N), COALESCE()
    - GROUP BY, ORDER BY
    - Subqueries (derived tables)
===============================================================================
*/

-- Q1: Which 5 products earn the most revenue?
-- Approach A: quick method with TOP
SELECT TOP 5
    p.product_name,
    SUM(f.sales_amount) AS product_revenue
FROM gold.fact_sales AS f
LEFT JOIN gold.dim_products AS p
    ON p.product_key = f.product_key
GROUP BY p.product_name
ORDER BY product_revenue DESC;

-- Approach B: window function, more flexible because it handles ties
-- and lets you filter on the rank value itself
SELECT *
FROM (
    SELECT
        p.product_name,
        SUM(f.sales_amount)                              AS product_revenue,
        RANK() OVER (ORDER BY SUM(f.sales_amount) DESC)  AS revenue_rank
    FROM gold.fact_sales AS f
    LEFT JOIN gold.dim_products AS p
        ON p.product_key = f.product_key
    GROUP BY p.product_name
) AS product_ranking
WHERE revenue_rank <= 5;

-- Q2: Which 5 products perform worst in terms of revenue?
-- (Driven from the fact table, so only products with at least
-- one sale can appear here.)
SELECT TOP 5
    p.product_name,
    SUM(f.sales_amount) AS product_revenue
FROM gold.fact_sales AS f
LEFT JOIN gold.dim_products AS p
    ON p.product_key = f.product_key
GROUP BY p.product_name
ORDER BY product_revenue;

-- Q2 (variant): Driven from the product dimension instead, so products
-- that never sold are included. COALESCE turns their NULL
-- revenue into 0, which makes them the true bottom performers.
SELECT TOP 5
    p.product_name,
    COALESCE(SUM(f.sales_amount), 0) AS product_revenue
FROM gold.dim_products AS p
LEFT JOIN gold.fact_sales AS f
    ON p.product_key = f.product_key
GROUP BY p.product_name
ORDER BY product_revenue;

-- Q3: Who are the 10 highest-spending customers?
SELECT TOP 10
    c.customer_key,
    c.first_name,
    c.last_name,
    SUM(f.sales_amount) AS customer_revenue
FROM gold.fact_sales AS f
LEFT JOIN gold.dim_customers AS c
    ON c.customer_key = f.customer_key
GROUP BY
    c.customer_key,
    c.first_name,
    c.last_name
ORDER BY customer_revenue DESC;

-- Q4: Which 3 customers have placed the fewest orders?
SELECT TOP 3
    c.customer_key,
    c.first_name,
    c.last_name,
    COUNT(DISTINCT f.order_number) AS order_count
FROM gold.fact_sales AS f
LEFT JOIN gold.dim_customers AS c
    ON c.customer_key = f.customer_key
GROUP BY
    c.customer_key,
    c.first_name,
    c.last_name
ORDER BY order_count;

-- Q4 (variant): Plenty of customers tie at the minimum order count, so
-- TOP 3 returns an arbitrary three of them. Ranking the
-- customers and keeping rank 1 returns every customer at
-- that lowest level.
SELECT *
FROM (
    SELECT
        c.customer_key,
        c.first_name,
        c.last_name,
        COUNT(DISTINCT f.order_number)                         AS order_count,
        RANK() OVER (ORDER BY COUNT(DISTINCT f.order_number))  AS order_rank
    FROM gold.fact_sales AS f
    LEFT JOIN gold.dim_customers AS c
        ON c.customer_key = f.customer_key
    GROUP BY
        c.customer_key,
        c.first_name,
        c.last_name
) AS customer_ranking
WHERE order_rank = 1;
