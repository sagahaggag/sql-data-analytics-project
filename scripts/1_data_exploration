/*
===============================================================================
Schema Discovery: Tables and Columns
===============================================================================
Goal:
    A first look at the data warehouse before any analysis. This script
    shows which tables and views exist, then drills into the column
    definitions of one table.

Metadata views queried:
    - INFORMATION_SCHEMA.TABLES
    - INFORMATION_SCHEMA.COLUMNS
===============================================================================
*/

-- Step 1: Catalogue every table and view available in the database
SELECT
    TABLE_CATALOG  AS database_name,
    TABLE_SCHEMA   AS schema_name,
    TABLE_NAME     AS object_name,
    TABLE_TYPE     AS object_type
FROM INFORMATION_SCHEMA.TABLES;

-- Step 2: Inspect the column definitions of the customer dimension
--         (data types, nullability, and maximum text length)
SELECT
    COLUMN_NAME,
    DATA_TYPE,
    IS_NULLABLE,
    CHARACTER_MAXIMUM_LENGTH
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'dim_customers';
